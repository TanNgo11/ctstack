{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "CTStack",
		"description": "CTStack portfolio & services site",
		"author": "CTStack"
	},
	"settings": {
		"title": "CTStack",
		"tagline": "Thiết kế & phát triển website, ứng dụng"
	},
	"collections": [
		{
			"slug": "projects",
			"label": "Projects",
			"labelSingular": "Project",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"urlPattern": "/projects/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image",
					"required": true
				},
				{
					"slug": "client",
					"label": "Client",
					"type": "string"
				},
				{
					"slug": "year",
					"label": "Year",
					"type": "string"
				},
				{
					"slug": "category",
					"label": "Category",
					"type": "select",
					"validation": {
						"options": ["website", "web_app", "mobile_app", "ecommerce", "landing_page"]
					}
				},
				{
					"slug": "industry",
					"label": "Industry",
					"type": "select",
					"validation": {
						"options": ["fnb", "beauty", "real_estate", "retail", "education", "other"]
					}
				},
				{
					"slug": "duration",
					"label": "Duration",
					"type": "string"
				},
				{
					"slug": "team_size",
					"label": "Team size",
					"type": "string"
				},
				{
					"slug": "features",
					"label": "Key features",
					"type": "repeater",
					"validation": {
						"maxItems": 12,
						"subFields": [
							{
								"slug": "item",
								"label": "Feature",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "live",
					"label": "Live project",
					"type": "boolean"
				},
				{
					"slug": "stack",
					"label": "Tech stack (comma separated)",
					"type": "string"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Case study",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "results",
					"label": "Results",
					"type": "repeater",
					"validation": {
						"maxItems": 6,
						"subFields": [
							{
								"slug": "value",
								"label": "Value (e.g. +40%)",
								"type": "string",
								"required": true
							},
							{
								"slug": "label",
								"label": "Label",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "gallery",
					"label": "Gallery",
					"type": "repeater",
					"validation": {
						"maxItems": 24,
						"subFields": [
							{
								"slug": "image",
								"label": "Image",
								"type": "image",
								"required": true
							},
							{
								"slug": "caption",
								"label": "Caption",
								"type": "text"
							}
						]
					}
				},
				{
					"slug": "url",
					"label": "Live URL",
					"type": "url"
				},
				{
					"slug": "featured",
					"label": "Show on homepage",
					"type": "boolean"
				},
				{
					"slug": "sort_order",
					"label": "Sort order (lower first)",
					"type": "integer"
				}
			]
		},
		{
			"slug": "services",
			"label": "Services",
			"labelSingular": "Service",
			"supports": ["drafts", "revisions", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "icon",
					"label": "Icon",
					"type": "select",
					"validation": {
						"options": [
							"globe",
							"cart",
							"layout",
							"smartphone",
							"wrench",
							"sparkles",
							"monitor",
							"code",
							"chart"
						]
					}
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "price_from",
					"label": "Price from (e.g. 8 triệu / $400)",
					"type": "string"
				},
				{
					"slug": "features",
					"label": "What's included",
					"type": "repeater",
					"validation": {
						"maxItems": 12,
						"subFields": [
							{
								"slug": "item",
								"label": "Item",
								"type": "string",
								"required": true
							}
						]
					}
				},
				{
					"slug": "content",
					"label": "Details",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "sort_order",
					"label": "Sort order (lower first)",
					"type": "integer"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"urlPattern": "/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
