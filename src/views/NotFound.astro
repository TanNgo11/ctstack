---
import Base from "../layouts/Base.astro";
import { langFromPath, localizePath, useTranslations } from "../i18n/ui";

const lang = langFromPath(Astro.originPathname ?? Astro.url.pathname);
const t = useTranslations(lang);
---

<Base title={t("notFound.title")} robots="noindex">
	<div class="not-found container">
		<span class="code text-gradient" aria-hidden="true">
			404
		</span>
		<h1>{t("notFound.title")}</h1>
		<p>{t("notFound.text")}</p>
		<div class="links">
			<a href={localizePath("/", lang)} class="btn btn-primary">
				{t("notFound.home")} <span aria-hidden="true">→</span>
			</a>
			<a href={localizePath("/projects", lang)} class="btn btn-ghost">
				{t("nav.projects")}
			</a>
		</div>
	</div>
</Base>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-block: var(--spacing-4xl) var(--spacing-3xl);
		text-align: center;
	}

	.code {
		display: block;
		margin-bottom: var(--spacing-md);
		font-size: clamp(6rem, 16vw, 11rem);
		font-weight: var(--font-weight-display);
		line-height: 1;
		letter-spacing: -0.05em;
		filter: drop-shadow(0 20px 60px color-mix(in srgb, #8b5cf6 35%, transparent));
	}

	h1 {
		margin-bottom: var(--spacing-sm);
		font-size: clamp(1.75rem, 2.6vw, 2.5rem);
		font-weight: var(--font-weight-display);
	}

	p {
		max-width: 32em;
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-md);
	}
</style>
