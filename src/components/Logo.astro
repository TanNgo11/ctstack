---
/**
 * Site logo: the uploaded logo from site settings, or the CTStack block C/S
 * mark plus the site title.
 */
interface Props {
	title: string;
	image?: { url?: string; alt?: string } | null;
	size?: "md" | "sm";
}

const { title, image, size = "md" } = Astro.props;
---

{image?.url ? (
	<img src={image.url} alt={image.alt || title} class:list={["logo-img", size]} />
) : (
	<span class:list={["logo", size]}>
		<svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
			<path class="logo-mark-top" d="M16 2 29 8.5 22.5 11.75 16 8.5 9.5 11.75 3 8.5Z" />
			<path class="logo-mark-top" d="M3 8.5v8L16 23l6.5-3.25v-8L16 15l-6.5-3.25Z" />
			<path class="logo-mark-bottom" d="m29 23.5-13 6.5-13-6.5 6.5-3.25 6.5 3.25 6.5-3.25Z" />
			<path class="logo-mark-bottom" d="M29 15.5v8L16 17l-6.5 3.25v-8L16 9l6.5 3.25Z" />
		</svg>
		<span class="logo-text">{title}</span>
	</span>
)}

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: var(--font-weight-display);
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.logo-mark {
		width: 1.35em;
		height: 1.35em;
		flex-shrink: 0;
	}

	.logo-mark-top {
		fill: light-dark(#0f172a, #f8fafc);
	}

	.logo-mark-bottom {
		fill: #2563eb;
	}

	.logo.sm {
		font-size: 1.25rem;
	}

	.logo-img {
		display: block;
		width: auto;
		height: 36px;
	}

	.logo-img.sm {
		height: 28px;
	}
</style>
