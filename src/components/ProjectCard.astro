---
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import { categoryLabel, langFromPath, useTranslations } from "../i18n/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	category?: string;
	edit?: EditProxy;
}

const { title, summary, featuredImage, href, client, year, category, edit } =
	Astro.props;
const lang = langFromPath(Astro.originPathname ?? Astro.url.pathname);
const t = useTranslations(lang);
const meta = [categoryLabel(lang, category), client, year].filter(Boolean);
---

<article class="project-card">
	<a href={href} class="card-link">
		<div class="card-image" {...edit?.featured_image}>
			<Image image={featuredImage} />
			<div class="card-overlay">
				<span class="card-view">{t("projects.view")}</span>
			</div>
		</div>
		<div class="card-content">
			{meta.length > 0 && <p class="card-meta">{meta.join(" · ")}</p>}
			<h3 class="card-title" {...edit?.title}>{title}</h3>
			{
				summary && (
					<p class="card-summary" {...edit?.summary}>
						{summary}
					</p>
				)
			}
		</div>
	</a>
</article>

<style>
	.card-link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		text-decoration: none;
		color: inherit;
	}

	.card-image {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
	}

	.card-image :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.card-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0);
		transition: background var(--transition-base);
	}

	/* Over-image chip: white regardless of theme */
	.card-view {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: white;
		padding: var(--spacing-sm) var(--spacing-md);
		border: 1px solid white;
		border-radius: var(--radius);
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.project-card:hover .card-image :global(img),
	.card-link:focus-visible .card-image :global(img) {
		transform: scale(1.03);
	}

	.project-card:hover .card-overlay,
	.card-link:focus-visible .card-overlay {
		background: rgba(0, 0, 0, 0.4);
	}

	.project-card:hover .card-view,
	.card-link:focus-visible .card-view {
		opacity: 1;
		transform: translateY(0);
	}

	.card-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}

	.card-meta {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	.card-title {
		font-size: var(--font-size-lg);
		transition: color var(--transition-fast);
	}

	.project-card:hover .card-title {
		color: var(--color-brand);
	}

	.card-summary {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
