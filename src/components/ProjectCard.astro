---
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import ServiceIcon from "./ServiceIcon.astro";
import { categoryLabel, langFromPath } from "../i18n/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	category?: string;
	/** Project results; the card highlights one (a percentage if there is one). */
	results?: { value: string; label: string }[];
	/**
	 * compact: home (icon card on mobile); large: projects page;
	 * row: text left, image right (related projects).
	 */
	size?: "compact" | "large" | "row";
	edit?: EditProxy;
}

const {
	title,
	summary,
	featuredImage,
	href,
	category,
	results,
	size = "large",
	edit,
} = Astro.props;
const lang = langFromPath(Astro.originPathname ?? Astro.url.pathname);
const label = categoryLabel(lang, category);
const result = results?.find((r) => r.value.includes("%")) ?? results?.[0];
const categoryIcon: Record<string, string> = {
	website: "monitor",
	ecommerce: "cart",
	web_app: "chart",
	mobile_app: "smartphone",
	landing_page: "sparkles",
};
---

<article class:list={["project-card", size]}>
	<a href={href} class="card-link">
		<div class="card-image" {...edit?.featured_image}>
			<Image image={featuredImage} />
		</div>
		{size === "compact" && (
			<span class="card-icon" aria-hidden="true">
				<ServiceIcon name={categoryIcon[category ?? ""]} />
			</span>
		)}
		<div class="card-content">
			<div class="card-text">
				{size === "large" && label && <span class="pill">{label}</span>}
				{size === "row" && label && <p class="card-eyebrow">{label}</p>}
				<h3 class="card-title" {...edit?.title}>
					{title}
				</h3>
				{size === "compact" && label && <p class="card-meta">{label}</p>}
				{size !== "compact" && summary && (
					<p class="card-summary" {...edit?.summary}>
						{summary}
					</p>
				)}
			</div>
			{size === "row" ? (
				<span class="card-arrow" aria-hidden="true">
					→
				</span>
			) : (
				result && (
					<p class="card-result">
						<strong class="text-accent">{result.value}</strong>
						<span>{result.label}</span>
					</p>
				)
			)}
		</div>
	</a>
</article>

<style>
	.project-card {
		height: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base);
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--color-brand) 55%, var(--color-border));
	}

	.card-link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		height: 100%;
		padding: 12px;
		color: inherit;
		text-decoration: none;
	}

	.card-image {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.card-image :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.compact .card-image :global(img) {
		aspect-ratio: 4 / 5;
	}

	.project-card:hover .card-image :global(img),
	.card-link:focus-visible .card-image :global(img) {
		transform: scale(1.03);
	}

	.card-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		padding: 0 var(--spacing-xs) var(--spacing-xs);
	}

	.card-text {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-xs);
	}

	.card-title {
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: 1.3;
	}

	.card-meta {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.card-summary {
		display: -webkit-box;
		overflow: hidden;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.card-result {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 6px;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.card-result strong {
		font-size: 1.25rem;
		font-weight: var(--font-weight-display);
	}

	/* Projects page: text left, result right */
	.large .card-link {
		padding: var(--spacing-md);
	}

	.large .card-content {
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: 0 var(--spacing-xs) var(--spacing-xs);
	}

	.large .card-text {
		gap: var(--spacing-sm);
	}

	.large .card-title {
		font-size: 1.375rem;
	}

	.large .card-result {
		flex-direction: column;
		align-items: flex-end;
		flex-shrink: 0;
		text-align: end;
	}

	.large .card-result strong {
		font-size: 2.25rem;
		line-height: 1.1;
	}

	@media (max-width: 640px) {
		.compact .card-image :global(img) {
			aspect-ratio: 1 / 1;
		}

		.compact .card-link {
			padding: 8px;
			gap: var(--spacing-sm);
		}

		.compact .card-title {
			font-size: var(--font-size-sm);
		}

		.compact .card-meta,
		.compact .card-result {
			font-size: var(--font-size-xs);
		}

		.compact .card-result strong {
			font-size: var(--font-size-sm);
		}

		.large .card-content {
			flex-direction: column;
		}

		.large .card-result {
			flex-direction: row;
			align-items: baseline;
			text-align: start;
		}

		.large .card-result strong {
			font-size: 1.75rem;
		}
	}
	.card-icon {
		display: none;
	}

	/* Related projects: text left, image right */
	.row .card-link {
		flex-direction: row-reverse;
		align-items: stretch;
		gap: var(--spacing-md);
		padding: var(--spacing-md);
	}

	.row .card-image {
		flex: 0 0 44%;
	}

	.row .card-image :global(img) {
		height: 100%;
		aspect-ratio: 4 / 3;
	}

	.row .card-content {
		flex: 1;
		justify-content: space-between;
		padding: 4px 0;
	}

	.card-eyebrow {
		color: var(--color-brand);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.row .card-summary {
		font-size: var(--font-size-xs);
		-webkit-line-clamp: 3;
	}

	.card-arrow {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast);
	}

	.project-card:hover .card-arrow {
		border-color: transparent;
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	@media (max-width: 640px) {
		/* Home on mobile: icon cards instead of images */
		.compact .card-image {
			display: none;
		}

		.compact .card-link {
			flex-direction: row;
			align-items: flex-start;
			gap: 10px;
			padding: 12px;
		}

		.compact .card-icon {
			display: grid;
			flex-shrink: 0;
			width: 36px;
			height: 36px;
			place-items: center;
			border-radius: var(--radius);
			color: var(--color-brand);
			background: var(--color-brand-ring);
		}

		.compact .card-icon :global(svg) {
			width: 18px;
			height: 18px;
		}

		.compact .card-content {
			padding: 0;
		}
	}
</style>
