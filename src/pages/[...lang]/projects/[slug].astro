---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../../layouts/Base.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { categoryLabel, localizePath, useTranslations, langFromParam } from "../../../i18n/ui";
import {
	contentAlternates,
	isNotFoundError,
	safeExternalUrl,
	splitByHeading,
	splitStack,
} from "../../../lib/content";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const {
	entry: project,
	error,
	cacheHint,
} = await getEmDashEntry("projects", slug, {
	locale: lang,
});
if (!project || isNotFoundError(error)) return Astro.rewrite("/404");
if (error) return new Response("Could not load the project", { status: 500 });

const [relatedResult, alternates] = await Promise.all([
	getEmDashCollection("projects", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 4,
	}),
	contentAlternates("projects", project.data.id, (s) => `/projects/${s}`),
]);
const otherProjects = (relatedResult.entries ?? []).filter((p) => p.id !== project.id).slice(0, 3);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (relatedResult.cacheHint) Astro.cache.set(relatedResult.cacheHint);
}

const d = project.data;
const featuredImageStorageKey =
	typeof d.featured_image?.meta?.storageKey === "string"
		? d.featured_image.meta.storageKey
		: undefined;
const projectUrl = safeExternalUrl(d.url);
const stack = splitStack(d.stack);
const results = d.results ?? [];
const gallery = d.gallery ?? [];
// Case studies are written as h2 sections (problem / solution / result).
const sections = splitByHeading(d.content as { style?: string }[] | undefined);
const facts = [
	{ label: t("projects.client"), value: d.client, edit: project.edit.client },
	{
		label: t("projects.type"),
		value: categoryLabel(lang, d.category),
		edit: project.edit.category,
	},
	{ label: t("projects.year"), value: d.year, edit: project.edit.year },
].filter((f) => f.value);

const seo = getSeoMeta(project, {
	siteUrl: Astro.url.origin,
	path: localizePath(`/projects/${slug}`, lang),
	defaultDescription: d.summary,
	defaultOgImage: d.featured_image?.src
		? d.featured_image.src
		: featuredImageStorageKey
			? `/_emdash/api/media/file/${featuredImageStorageKey}`
			: undefined,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "projects", id: d.id, slug }}
	alternates={alternates}
>
	<article class="project container">
		<header class="project-hero">
			<div class="project-intro">
				<a href={localizePath("/projects", lang)} class="back">
					<span aria-hidden="true">←</span>
					{t("projects.back")}
				</a>
				{d.category && <p class="eyebrow">{categoryLabel(lang, d.category)}</p>}
				<h1 class="project-title" {...project.edit.title}>
					{d.title}
				</h1>
				{d.summary && (
					<p class="project-summary" {...project.edit.summary}>
						{d.summary}
					</p>
				)}
				{projectUrl && (
					<a
						href={projectUrl}
						class="btn btn-primary"
						target="_blank"
						rel="noopener noreferrer"
						{...project.edit.url}
					>
						{t("projects.live")} <span aria-hidden="true">↗</span>
					</a>
				)}
			</div>
			{d.featured_image && (
				<div class="browser" {...project.edit.featured_image}>
					<div class="browser-bar" aria-hidden="true">
						<i />
						<i />
						<i />
					</div>
					<Image image={d.featured_image} />
				</div>
			)}
		</header>

		<div class="project-overview">
			<dl class="facts card">
				{facts.map((f) => (
					<div>
						<dt>{f.label}</dt>
						<dd {...f.edit}>{f.value}</dd>
					</div>
				))}
				{stack.length > 0 && (
					<div>
						<dt>{t("projects.stack")}</dt>
						<dd class="stack" {...project.edit.stack}>
							{stack.map((s) => (
								<span class="pill">{s}</span>
							))}
						</dd>
					</div>
				)}
			</dl>

			{results.length > 0 && (
				<section class="results" aria-labelledby="results-title" {...project.edit.results}>
					<h2 id="results-title">{t("projects.highlights")}</h2>
					<div class="results-grid">
						{results.map((r, i) => (
							<div class="result card">
								<span class="result-icon" aria-hidden="true">
									{i % 2 === 0 ? (
										<svg viewBox="0 0 24 24" fill="currentColor">
											<path d="M13 2 4 14h7l-1 8 9-12h-7z" />
										</svg>
									) : (
										<svg viewBox="0 0 24 24" fill="currentColor">
											<rect x="4" y="13" width="4" height="7" rx="1" />
											<rect x="10" y="8" width="4" height="12" rx="1" />
											<rect x="16" y="4" width="4" height="16" rx="1" />
										</svg>
									)}
								</span>
								<div>
									<span class="result-value">{r.value}</span>
									<span class="result-label">{r.label}</span>
								</div>
							</div>
						))}
					</div>
				</section>
			)}
		</div>

		{sections.length > 0 && (
			<div class:list={["story", { columns: sections.length > 1 }]} {...project.edit.content}>
				{sections.map((section) => (
					<div class="prose story-section">
						<PortableText value={section} />
					</div>
				))}
			</div>
		)}

		{gallery.length > 0 && (
			<section class="gallery-section" aria-labelledby="gallery-title">
				<h2 id="gallery-title" class="block-title">
					{t("projects.gallery")}
				</h2>
				<div class="project-gallery" {...project.edit.gallery}>
					{gallery.map((item) => (
						<figure class="gallery-item">
							<Image image={item.image} />
							{item.caption && <figcaption>{item.caption}</figcaption>}
						</figure>
					))}
				</div>
			</section>
		)}
	</article>

	{otherProjects.length > 0 && (
		<section class="more container">
			<header class="section-header">
				<h2 class="section-title">{t("projects.other")}</h2>
				<a href={localizePath("/projects", lang)} class="section-link">
					{t("home.projectsLink")} →
				</a>
			</header>
			<div class="more-grid">
				{otherProjects.map((p) => (
					<ProjectCard
						size="row"
						title={p.data.title}
						summary={p.data.summary}
						featuredImage={p.data.featured_image}
						href={localizePath(`/projects/${p.id}`, lang)}
						category={p.data.category}
						results={p.data.results}
						edit={p.edit}
					/>
				))}
			</div>
		</section>
	)}
</Base>

<style>
	.project-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		align-items: start;
		gap: var(--spacing-2xl);
		padding-block: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.back {
		display: inline-flex;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-2xl);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.back span {
		color: var(--color-brand);
	}

	.back:hover {
		color: var(--color-brand);
	}

	.project-title {
		margin-bottom: var(--spacing-md);
		font-size: clamp(2.25rem, 3.3vw, 3rem);
		font-weight: var(--font-weight-display);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.project-summary {
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.browser {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		box-shadow: 0 20px 50px #0004;
	}

	.browser-bar {
		display: flex;
		gap: 6px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--color-border);
	}

	.browser-bar i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #ef4444;
	}

	.browser-bar i:nth-child(2) {
		background: #f59e0b;
	}

	.browser-bar i:nth-child(3) {
		background: #22c55e;
	}

	.browser :global(img) {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.project-overview {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr);
		gap: var(--spacing-lg);
		padding-block: var(--spacing-lg) var(--spacing-2xl);
	}

	.facts {
		display: grid;
		align-content: start;
		gap: var(--spacing-md);
		padding: var(--spacing-lg);
	}

	.facts div {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: var(--spacing-md);
	}

	.facts dt {
		color: var(--color-muted);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.results h2 {
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-lg);
		font-weight: 600;
	}

	.results-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--spacing-md);
	}

	.result {
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
		padding: var(--spacing-lg);
	}

	.result-icon {
		display: grid;
		flex-shrink: 0;
		width: 72px;
		height: 72px;
		place-items: center;
		border-radius: 50%;
		color: var(--color-brand);
		background: var(--color-brand-ring);
	}

	.result-icon svg {
		width: 30px;
		height: 30px;
	}

	.result:nth-child(even) .result-icon {
		color: var(--color-brand-end);
	}

	.result-value {
		display: block;
		font-size: 2rem;
		font-weight: var(--font-weight-display);
		line-height: 1.1;
	}

	.result-label {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.story {
		max-width: var(--max-width);
		padding-block: var(--spacing-lg);
	}

	.story.columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		max-width: none;
	}

	.story.columns .story-section {
		padding-inline: var(--spacing-xl);
		border-inline-start: 1px solid var(--color-border);
	}

	.story.columns .story-section:first-child {
		padding-inline-start: 0;
		border-inline-start: 0;
	}

	.story-section :global(h2) {
		margin-top: 0;
		font-size: 1.5rem;
		font-weight: var(--font-weight-display);
	}

	.story-section :global(p) {
		color: var(--color-muted);
	}

	.block-title {
		margin-bottom: var(--spacing-lg);
		font-size: var(--font-size-xl);
		font-weight: 600;
	}

	.gallery-section {
		padding-block: var(--spacing-xl);
	}

	.project-gallery {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	.gallery-item :global(img) {
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.gallery-item figcaption {
		margin-top: var(--spacing-sm);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.more {
		padding-block: var(--spacing-2xl);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	@media (max-width: 900px) {
		.project-hero,
		.project-overview {
			grid-template-columns: 1fr;
		}

		.story.columns .story-section {
			padding: var(--spacing-md) 0;
			border-inline-start: 0;
			border-top: 1px solid var(--color-border);
		}

		.story.columns .story-section:first-child {
			border-top: 0;
		}
	}

	@media (max-width: 640px) {
		.back {
			margin-bottom: var(--spacing-lg);
		}

		.facts div {
			grid-template-columns: 96px 1fr;
		}

		.result-icon {
			width: 52px;
			height: 52px;
		}

		.result-value {
			font-size: 1.5rem;
		}

		.project-gallery,
		.more-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
