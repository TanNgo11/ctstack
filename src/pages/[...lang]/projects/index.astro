---
import { getEmDashCollection } from "emdash";
import Base from "../../../layouts/Base.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import {
	categoryLabel,
	industryLabel,
	localizePath,
	projectCategories,
	projectIndustries,
	langFromParam,
	useTranslations,
} from "../../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);
const basePath = localizePath("/projects", lang);

const rawCategory = Astro.url.searchParams.get("category");
const activeCategory = projectCategories.find((c) => c === rawCategory);
const rawIndustry = Astro.url.searchParams.get("industry");
const activeIndustry = projectIndustries.find((i) => i === rawIndustry);
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const filters = {
	...(activeCategory ? { category: activeCategory } : {}),
	...(activeIndustry ? { industry: activeIndustry } : {}),
};

const [allResult, result] = await Promise.all([
	getEmDashCollection("projects", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 100,
	}),
	getEmDashCollection("projects", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 12,
		cursor,
		...(Object.keys(filters).length > 0 ? { where: filters } : {}),
	}),
]);
if (allResult.error || result.error) {
	return new Response("Could not load projects", { status: 500 });
}
const { entries: projects, nextCursor } = result;
const allProjects = allResult.entries;
const categoryCounts = new Map(
	projectCategories.map((category) => [
		category,
		allProjects.filter((p) => p.data.category === category).length,
	]),
);
const industryCounts = new Map(
	projectIndustries.map((industry) => [
		industry,
		allProjects.filter((p) => p.data.industry === industry).length,
	]),
);
if (Astro.cache?.enabled) {
	Astro.cache.set(allResult.cacheHint);
	Astro.cache.set(result.cacheHint);
}

// Hide filter options with no projects (unless the URL selects one).
const visibleCategories = projectCategories.filter(
	(c) => (categoryCounts.get(c) ?? 0) > 0 || c === activeCategory,
);
const visibleIndustries = projectIndustries.filter(
	(i) => (industryCounts.get(i) ?? 0) > 0 || i === activeIndustry,
);

function pageUrl(params: Record<string, string | undefined>): string {
	const search = new URLSearchParams();
	const query = { category: activeCategory, industry: activeIndustry, ...params };
	for (const [k, v] of Object.entries(query)) if (v) search.set(k, v);
	const qs = search.toString();
	return qs ? `${basePath}?${qs}` : basePath;
}
---

<Base
	title={
		activeCategory || activeIndustry
			? `${categoryLabel(lang, activeCategory) ?? industryLabel(lang, activeIndustry)} — ${t("projects.title")}`
			: t("projects.title")
	}
	description={t("projects.intro")}
	robots={cursor ? "noindex, follow" : undefined}
>
	<div class="container">
		<header class="page-header">
			<div class="page-header-top">
				<div>
					<p class="eyebrow">{t("projects.eyebrow")}</p>
					<h1>{t("projects.title")}</h1>
				</div>
			</div>
			<p class="page-intro">{t("projects.intro")}</p>

			<nav class="filters" aria-label={t("projects.type")}>
				<span class="filter-label" aria-hidden="true">
					{t("projects.type")}
				</span>
				<a
					href={pageUrl({ category: undefined, cursor: undefined })}
					class:list={["filter", { active: !activeCategory }]}
					aria-current={!activeCategory ? "page" : undefined}
				>
					{t("projects.all")} <span class="filter-count">{allProjects.length}</span>
				</a>
				{visibleCategories.map((c) => (
					<a
						href={pageUrl({ category: c, cursor: undefined })}
						class:list={["filter", { active: activeCategory === c }]}
						aria-current={activeCategory === c ? "page" : undefined}
					>
						{categoryLabel(lang, c)} <span class="filter-count">{categoryCounts.get(c) ?? 0}</span>
					</a>
				))}
			</nav>

			<nav class="filters" aria-label={t("projects.industry")}>
				<span class="filter-label" aria-hidden="true">
					{t("projects.industry")}
				</span>
				<a
					href={pageUrl({ industry: undefined, cursor: undefined })}
					class:list={["filter", { active: !activeIndustry }]}
					aria-current={!activeIndustry ? "page" : undefined}
				>
					{t("projects.all")} <span class="filter-count">{allProjects.length}</span>
				</a>
				{visibleIndustries.map((industry) => (
					<a
						href={pageUrl({ industry, cursor: undefined })}
						class:list={["filter", { active: activeIndustry === industry }]}
						aria-current={activeIndustry === industry ? "page" : undefined}
					>
						{industryLabel(lang, industry)}{" "}
						<span class="filter-count">{industryCounts.get(industry) ?? 0}</span>
					</a>
				))}
			</nav>
		</header>

		{projects.length > 0 ? (
			<section class="projects-grid">
				{projects.map((p) => (
					<ProjectCard
						title={p.data.title}
						summary={p.data.summary}
						featuredImage={p.data.featured_image}
						href={localizePath(`/projects/${p.id}`, lang)}
						category={p.data.category}
						stack={p.data.stack}
						duration={p.data.duration}
						live={p.data.live}
						results={p.data.results}
						edit={p.edit}
					/>
				))}
				{!nextCursor && (
					<a class="next-card" href={localizePath("/contact", lang)}>
						<span class="next-muted">{t("projects.moreComing")}</span>
						<span class="next-rule" aria-hidden="true" />
						<span>{t("projects.nextCta")}</span>
						<span class="next-arrow" aria-hidden="true">
							→
						</span>
					</a>
				)}
			</section>
		) : (
			<p class="empty-state">{activeCategory ? t("projects.emptyFilter") : t("projects.empty")}</p>
		)}

		{nextCursor && (
			<nav class="pagination">
				<a class="btn btn-ghost" href={pageUrl({ cursor: nextCursor })} rel="next">
					{t("projects.more")}
				</a>
			</nav>
		)}
	</div>
</Base>

<style>
	.page-header-top {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--spacing-lg);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: var(--spacing-xl);
	}

	.filter-label {
		align-self: center;
		min-width: 4.5em;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.filters + .filters {
		margin-top: var(--spacing-md);
	}

	.filter {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--spacing-lg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text);
		background: var(--color-surface);
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-decoration: none;
		transition: border-color var(--transition-fast);
	}

	.filter-count {
		margin-inline-start: 6px;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.filter.active .filter-count {
		color: inherit;
		opacity: 0.8;
	}

	.filter:hover {
		border-color: var(--color-brand);
	}

	.filter.active {
		border-color: transparent;
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-lg);
		padding-bottom: var(--spacing-2xl);
	}

	.next-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-lg);
		min-height: 280px;
		padding: var(--spacing-2xl);
		color: var(--color-text);
		font-size: var(--font-size-lg);
		text-align: center;
		text-decoration: none;
	}

	/* Alone on its row (even number of projects): lay out horizontally. */
	.projects-grid > .next-card:nth-child(odd) {
		grid-column: 1 / -1;
		flex-direction: row;
		flex-wrap: wrap;
		min-height: 0;
		padding: var(--spacing-xl);
	}

	.projects-grid > .next-card:nth-child(odd) .next-muted {
		max-width: none;
	}

	.projects-grid > .next-card:nth-child(odd) .next-rule {
		width: 1px;
		height: 24px;
	}

	.next-muted {
		max-width: 18em;
		color: var(--color-muted);
	}

	.next-rule {
		width: 48px;
		height: 1px;
		background: var(--color-border);
	}

	.next-arrow {
		display: grid;
		width: 56px;
		height: 56px;
		place-items: center;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast);
	}

	.next-card:hover .next-arrow {
		border-color: transparent;
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	.pagination {
		margin-bottom: var(--spacing-2xl);
		text-align: center;
	}

	@media (max-width: 768px) {
		.filters {
			flex-wrap: nowrap;
			overflow-x: auto;
			margin-inline: -20px;
			padding-inline: 20px;
			padding-bottom: 4px;
		}

		.filter {
			flex-shrink: 0;
			min-height: 40px;
			padding: 0 var(--spacing-md);
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}

		.next-card {
			min-height: 0;
			font-size: var(--font-size-base);
		}
	}
</style>
