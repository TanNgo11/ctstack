---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import TechLogo from "../../components/TechLogo.astro";
import ContactForm from "../../components/ContactForm.astro";
import TestimonialCard from "../../components/TestimonialCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import PricingTiers from "../../components/PricingTiers.astro";
import {
	contactEmail,
	localizePath,
	useTranslations,
	langFromParam,
	techStack,
} from "../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);

const [projectsResult, servicesResult, testimonialsResult] = await Promise.all([
	getEmDashCollection("projects", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 24,
	}),
	getEmDashCollection("services", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 5,
	}),
	getEmDashCollection("testimonials", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 24,
	}),
]);
if (projectsResult.error || servicesResult.error) {
	return new Response("Could not load content", { status: 500 });
}
// Testimonials are optional: the section only renders real, featured quotes.
const testimonials = (testimonialsResult.entries ?? []).filter((q) => q.data.featured).slice(0, 3);
// `where` only matches string values, so pick featured projects here.
const projects = projectsResult.entries.filter((p) => p.data.featured).slice(0, 4);
const services = servicesResult.entries;
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
	if (testimonialsResult.cacheHint) Astro.cache.set(testimonialsResult.cacheHint);
}

const contactHref = localizePath("/contact", lang);
// Decorative dashboard illustration in the hero (not real data).
const chartBars = [38, 52, 44, 60, 55, 72, 86];
const chartLine = "4,30 18,24 32,27 46,18 60,20 74,12 90,6";
const sidebarIcons = [
	"M3 12 12 3l9 9M5 10v10h14V10",
	"M4 7h16v13H4zM9 7V4h6v3",
	"M5 4h14v16H5zM9 9h6M9 13h6",
	"M16 21v-2a4 4 0 0 0-8 0v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8",
	"M4 20V10M10 20V4M16 20v-7M22 20H2",
	"M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6M19 12h2M3 12h2M12 3v2M12 19v2",
];
const productTiles = ["mug", "cap", "bag", "shoe"];
const phonePrices = ["320.000đ", "250.000đ", "420.000đ", "680.000đ"];
---

<Base hideCta>
	<section class="hero container">
		<div class="hero-copy">
			<p class="eyebrow hero-eyebrow">{t("home.eyebrow")}</p>
			<h1 class="hero-title">{t("home.title")}</h1>
			<p class="hero-intro">{t("home.intro")}</p>
			<div class="hero-actions">
				<a href={contactHref} class="btn btn-primary">
					{t("home.ctaPrimary")} <span aria-hidden="true">→</span>
				</a>
				<a href={localizePath("/projects", lang)} class="btn btn-ghost">
					{t("home.ctaSecondary")}
				</a>
			</div>
		</div>

		<div class="hero-visual" aria-hidden="true">
			<div class="laptop">
				<div class="screen">
					<div class="mock-sidebar">
						<span class="mock-brand">
							<i></i>CTStack
						</span>
						{sidebarIcons.map((d, i) => (
							<span class:list={["mock-nav", { active: i === 0 }]}>
								<svg viewBox="0 0 24 24">
									<path d={d} />
								</svg>
								<b />
							</span>
						))}
					</div>
					<div class="mock-main">
						<div class="mock-search">
							<span></span>
							<i></i>
							<i></i>
							<i></i>
						</div>
						<div class="mock-kpis">
							<div>
								<small>{t("home.mockRevenue")}</small>
								<b>128.450.000đ</b>
								<em>↑ 12%</em>
							</div>
							<div>
								<small>{t("home.mockOrders")}</small>
								<b>1.204</b>
								<em>↑ 18%</em>
							</div>
							<div>
								<small>{t("home.mockCustomers")}</small>
								<b>892</b>
								<em>↑ 14%</em>
							</div>
						</div>
						<div class="mock-chart">
							<small>{t("home.mockChart")}</small>
							<div class="mock-plot">
								<div class="mock-bars">
									{chartBars.map((h) => (
										<span style={`height:${h}%`} />
									))}
								</div>
								<svg class="mock-line" viewBox="0 0 100 40" preserveAspectRatio="none">
									<polyline points={chartLine} />
									{chartLine.split(" ").map((pt) => {
										const [x, y] = pt.split(",");
										return <circle cx={x} cy={y} r="1.2" />;
									})}
								</svg>
							</div>
						</div>
						<div class="mock-products">
							{productTiles.map((p) => (
								<span class={`tile tile-${p}`} />
							))}
						</div>
					</div>
				</div>
				<div class="laptop-base"></div>
			</div>
			<div class="phone">
				<div class="phone-screen">
					<div class="phone-head">
						<small>{t("home.mockShop")}</small>
						<i></i>
					</div>
					<div class="phone-tabs">
						<span class="on"></span>
						<span></span>
						<span></span>
					</div>
					<div class="phone-grid">
						{productTiles.map((p, i) => (
							<div>
								<span class={`tile tile-${p}`} />
								<small>{phonePrices[i]}</small>
							</div>
						))}
					</div>
					<div class="phone-tabbar">
						<i></i>
						<i></i>
						<i></i>
						<i></i>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="tech container" aria-labelledby="tech-title">
		<p class="tech-title" id="tech-title">
			<span>{t("home.techTitle")}</span>
		</p>
		<ul class="tech-list">
			{techStack.map((name) => (
				<li>
					<TechLogo name={name} />
					{name}
				</li>
			))}
		</ul>
	</section>

	{services.length > 0 && (
		<section class="section container">
			<header class="section-header">
				<div>
					<p class="eyebrow">{t("home.servicesEyebrow")}</p>
					<h2 class="section-title">{t("home.servicesTitle")}</h2>
				</div>
				<a href={localizePath("/services", lang)} class="section-link">
					{t("home.servicesLink")} →
				</a>
			</header>
			<div class="services-grid">
				{services.map((s) => (
					<ServiceCard
						title={s.data.title}
						summary={s.data.summary}
						icon={s.data.icon}
						priceFrom={s.data.price_from}
						edit={s.edit}
					/>
				))}
			</div>
		</section>
	)}

	{projects.length > 0 && (
		<section class="section container">
			<header class="section-header">
				<div>
					<p class="eyebrow">{t("home.projectsEyebrow")}</p>
					<h2 class="section-title">{t("home.projectsTitle")}</h2>
				</div>
				<a href={localizePath("/projects", lang)} class="section-link">
					{t("home.projectsLink")} →
				</a>
			</header>
			<div class="projects-grid">
				{projects.map((p) => (
					<ProjectCard
						size="compact"
						title={p.data.title}
						summary={p.data.summary}
						featuredImage={p.data.featured_image}
						href={localizePath(`/projects/${p.id}`, lang)}
						category={p.data.category}
						results={p.data.results}
						edit={p.edit}
					/>
				))}
			</div>
		</section>
	)}

	{testimonials.length > 0 && (
		<section class="section container" aria-labelledby="testimonials-title">
			<header class="section-header">
				<div>
					<p class="eyebrow">{t("home.testimonialsEyebrow")}</p>
					<h2 class="section-title" id="testimonials-title">
						{t("home.testimonialsTitle")}
					</h2>
				</div>
			</header>
			<div class="testimonials-grid">
				{testimonials.map((q) => (
					<TestimonialCard
						quote={q.data.quote}
						author={q.data.author}
						role={q.data.role}
						company={q.data.company}
						avatar={q.data.avatar}
						edit={q.edit}
					/>
				))}
			</div>
		</section>
	)}

	<section class="section container" aria-labelledby="why-title">
		<header class="section-header">
			<div>
				<p class="eyebrow">{t("home.whyEyebrow")}</p>
				<h2 class="section-title" id="why-title">
					{t("home.whyTitle")}
				</h2>
			</div>
		</header>
		<ul class="why">
			{t("home.why").map(([title, text], i) => (
				<li>
					<span class="why-num">{String(i + 1).padStart(2, "0")}</span>
					<h3>{title}</h3>
					<p>{text}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="section container" aria-labelledby="pricing-title">
		<header class="section-header">
			<div>
				<p class="eyebrow">{t("home.pricingEyebrow")}</p>
				<h2 class="section-title" id="pricing-title">
					{t("home.pricingTitle")}
				</h2>
			</div>
		</header>
		<PricingTiers tiers={t("home.tiers")} note={t("home.pricingNote")} />
	</section>

	<section class="section container">
		<header class="section-header">
			<div>
				<p class="eyebrow">{t("home.processEyebrow")}</p>
				<h2 class="section-title">{t("home.processTitle")}</h2>
			</div>
		</header>
		<ol class="process">
			{t("home.process").map(([title, text], i) => (
				<li class="process-step">
					<span class="process-num">{String(i + 1).padStart(2, "0")}</span>
					<div>
						<h3>{title}</h3>
						<p>{text}</p>
					</div>
				</li>
			))}
		</ol>
	</section>
	<section class="section container home-contact" aria-labelledby="home-contact-title">
		<div class="home-contact-text">
			<p class="eyebrow">{t("home.contactEyebrow")}</p>
			<h2 class="section-title" id="home-contact-title">
				{t("contact.title")}
			</h2>
			<p>{t("contact.intro")}</p>
			<ul class="trust">
				{t("contact.trust").map((item) => (
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 12 5 5L20 7" />
						</svg>
						{item}
					</li>
				))}
			</ul>
			{contactEmail && (
				<p class="home-contact-email">
					<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
				</p>
			)}
		</div>
		<ContactForm titleId="home-form-title" />
	</section>
</Base>

<style>
	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--spacing-2xl);
		padding-block: var(--spacing-3xl) var(--spacing-2xl);
	}

	.hero-title {
		margin-bottom: var(--spacing-lg);
		font-size: clamp(2.5rem, 4.2vw, 3.75rem);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.hero-intro {
		max-width: 520px;
		margin-bottom: var(--spacing-xl);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.hero-actions .btn-primary {
		min-width: 170px;
	}

	/* Hero illustration (decorative, not real data) */
	.hero-visual {
		position: relative;
		padding: var(--spacing-lg) 64px var(--spacing-lg) 0;
	}

	.laptop .screen {
		display: grid;
		grid-template-columns: 21% 1fr;
		gap: 10px;
		aspect-ratio: 16 / 10.5;
		padding: 10px;
		border: 7px solid #1c2030;
		border-radius: 16px 16px 4px 4px;
		background: #0e1119;
		box-shadow: 0 30px 80px #0008;
	}

	.laptop-base {
		width: 112%;
		height: 12px;
		margin-left: -6%;
		border-radius: 0 0 14px 14px;
		background: linear-gradient(#2a2f40, #151823);
	}

	.mock-sidebar {
		display: flex;
		flex-direction: column;
		gap: 7px;
		padding-top: 2px;
	}

	.mock-brand {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-bottom: 6px;
		color: #f4f5f7;
		font-size: 9px;
		font-weight: 700;
	}

	.mock-brand i {
		width: 9px;
		height: 9px;
		border-radius: 2px;
		background: #3b82f6;
	}

	.mock-nav {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 4px 5px;
		border-radius: 4px;
	}

	.mock-nav svg {
		width: 9px;
		height: 9px;
		flex-shrink: 0;
		fill: none;
		stroke: #9aa3b2;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.mock-nav b {
		flex: 1;
		height: 4px;
		border-radius: 2px;
		background: #2a2f40;
	}

	.mock-nav.active {
		background: #2563eb;
	}

	.mock-nav.active svg {
		stroke: #fff;
	}

	.mock-nav.active b {
		background: #fff9;
	}

	.mock-main {
		display: flex;
		flex-direction: column;
		gap: 7px;
		min-width: 0;
		padding: 8px;
		border-radius: 8px;
		color: #12151c;
		background: #f4f6fb;
	}

	.mock-search {
		display: flex;
		align-items: center;
		gap: 5px;
	}

	.mock-search span {
		width: 45%;
		height: 12px;
		margin-inline-end: auto;
		border-radius: 4px;
		background: #fff;
	}

	.mock-search i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d0d6e2;
	}

	.mock-kpis {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}

	.mock-kpis div {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 6px;
		border-radius: 6px;
		background: #fff;
	}

	.mock-main small {
		overflow: hidden;
		color: #667085;
		font-size: 8px;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.mock-kpis b {
		overflow: hidden;
		font-size: clamp(8px, 0.85vw, 12px);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.mock-kpis em {
		color: #16a34a;
		font-size: 8px;
		font-style: normal;
	}

	.mock-chart {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		padding: 6px 8px;
		border-radius: 6px;
		background: #fff;
	}

	.mock-plot {
		position: relative;
		flex: 1;
		margin-top: 4px;
	}

	.mock-bars {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		gap: 9%;
		padding-inline: 2%;
	}

	.mock-bars span {
		flex: 1;
		border-radius: 2px 2px 0 0;
		background: #dbe3fb;
	}

	.mock-line {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.mock-line polyline {
		fill: none;
		stroke: #3b82f6;
		stroke-width: 1.2;
		vector-effect: non-scaling-stroke;
	}

	.mock-line circle {
		fill: #3b82f6;
	}

	.mock-products {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 6px;
		height: 22%;
	}

	/* Product thumbnails drawn with CSS */
	.tile {
		position: relative;
		display: block;
		border-radius: 5px;
		background: #e9ecf2;
	}

	.tile::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 55%;
		transform: translate(-50%, -50%);
	}

	.tile-mug::after {
		width: 32%;
		height: 42%;
		border-radius: 2px 2px 5px 5px;
		background: #1f2430;
		box-shadow: 5px 0 0 -2px #1f2430;
	}

	.tile-cap::after {
		width: 46%;
		height: 30%;
		border-radius: 50% 50% 8% 8%;
		background: #cfd3db;
	}

	.tile-bag::after {
		width: 34%;
		height: 44%;
		border-radius: 3px 3px 6px 6px;
		background: #1f4d3a;
	}

	.tile-shoe::after {
		width: 52%;
		height: 22%;
		border-radius: 40% 60% 20% 20%;
		background: #20242e;
	}

	.phone {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 30%;
		aspect-ratio: 9 / 19;
		padding: 5px;
		border: 2px solid #3b4260;
		border-radius: 28px;
		background: #0e1119;
		box-shadow: 0 20px 60px #000a;
	}

	.phone-screen {
		display: flex;
		flex-direction: column;
		gap: 7px;
		height: 100%;
		padding: 16px 8px 8px;
		border-radius: 22px;
		color: #12151c;
		background: #fff;
	}

	.phone-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.phone-head small {
		font-size: 11px;
		font-weight: 700;
	}

	.phone-head i {
		width: 10px;
		height: 10px;
		border: 1.5px solid #12151c;
		border-radius: 50%;
	}

	.phone-tabs {
		display: flex;
		gap: 4px;
	}

	.phone-tabs span {
		width: 28%;
		height: 10px;
		border-radius: 999px;
		background: #eef1f7;
	}

	.phone-tabs .on {
		background: #3b82f6;
	}

	.phone-grid {
		display: grid;
		flex: 1;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
	}

	.phone-grid div {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.phone-grid .tile {
		flex: 1;
	}

	.phone-grid small {
		font-size: 7px;
		font-weight: 600;
	}

	.phone-tabbar {
		display: flex;
		justify-content: space-around;
		padding-top: 4px;
		border-top: 1px solid #eef1f7;
	}

	.phone-tabbar i {
		width: 10px;
		height: 10px;
		border-radius: 3px;
		background: #d0d6e2;
	}

	.phone-tabbar i:first-child {
		background: #3b82f6;
	}

	/* Tech strip */
	.tech {
		padding-block: var(--spacing-lg) var(--spacing-2xl);
	}

	.tech-title {
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.tech-title::before,
	.tech-title::after {
		content: "";
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.tech-list {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-lg);
		list-style: none;
	}

	.tech-list li {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--color-muted);
		font-size: var(--font-size-base);
	}

	.tech-list :global(.tech-logo) {
		width: 30px;
		height: 30px;
	}

	/* Grids */
	.services-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	/* Process */
	.process {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-2xl);
		list-style: none;
	}

	/* Connector between steps, drawn in the column gap */
	.process-step:not(:last-child)::after {
		content: "";
		position: absolute;
		top: 32px;
		right: -40px;
		width: 32px;
		height: 1px;
		background: var(--color-border);
	}

	.process-step {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-md);
	}

	.process-num {
		display: grid;
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		place-items: center;
