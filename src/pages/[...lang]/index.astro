---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { localizePath, useTranslations, langFromParam } from "../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);

const [projectsResult, servicesResult] = await Promise.all([
	getEmDashCollection("projects", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 24,
	}),
	getEmDashCollection("services", {
		locale: lang,
		orderBy: { sort_order: "asc" },
		limit: 6,
	}),
]);
if (projectsResult.error || servicesResult.error) {
	return new Response("Could not load content", { status: 500 });
}
// `where` only matches string values, so pick featured projects here.
const projects = projectsResult.entries.filter((p) => p.data.featured).slice(0, 4);
const services = servicesResult.entries;
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
}

const contactHref = localizePath("/contact", lang);
---

<Base>
	<section class="hero container">
		<p class="eyebrow">{t("home.eyebrow")}</p>
		<h1 class="hero-title">{t("home.title")}</h1>
		<p class="hero-intro">{t("home.intro")}</p>
		<div class="hero-actions">
			<a href={contactHref} class="btn btn-primary">{t("home.ctaPrimary")} →</a>
			<a href={localizePath("/projects", lang)} class="btn btn-ghost"
				>{t("home.ctaSecondary")}</a
			>
		</div>
	</section>

	{
		services.length > 0 && (
			<section class="block container">
				<header class="section-header">
					<h2 class="section-title">{t("home.servicesTitle")}</h2>
					<a href={localizePath("/services", lang)} class="section-link">
						{t("home.servicesLink")} →
					</a>
				</header>
				<div class="services-grid">
					{services.map((s) => (
						<ServiceCard
							title={s.data.title}
							summary={s.data.summary}
							icon={s.data.icon}
							priceFrom={s.data.price_from}
							edit={s.edit}
						/>
					))}
				</div>
			</section>
		)
	}

	{
		projects.length > 0 && (
			<section class="block container">
				<header class="section-header">
					<h2 class="section-title">{t("home.projectsTitle")}</h2>
					<a href={localizePath("/projects", lang)} class="section-link">
						{t("home.projectsLink")} →
					</a>
				</header>
				<div class="projects-grid">
					{projects.map((p) => (
						<ProjectCard
							title={p.data.title}
							summary={p.data.summary}
							featuredImage={p.data.featured_image}
							href={localizePath(`/projects/${p.id}`, lang)}
							client={p.data.client}
							year={p.data.year}
							category={p.data.category}
							edit={p.edit}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="block container">
		<header class="section-header">
			<h2 class="section-title">{t("home.processTitle")}</h2>
		</header>
		<ol class="process">
			{
				t("home.process").map(([title, text], i) => (
					<li class="process-step">
						<span class="process-num">{String(i + 1).padStart(2, "0")}</span>
						<h3>{title}</h3>
						<p>{text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="container">
		<div class="cta-band">
			<div>
				<h2>{t("home.ctaBandTitle")}</h2>
				<p>{t("home.ctaBandText")}</p>
			</div>
			<a href={contactHref} class="btn btn-primary">{t("home.ctaPrimary")} →</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-4xl);
		max-width: 880px;
		margin-inline: auto;
		text-align: center;
	}

	.hero-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-lg);
	}

	.hero-intro {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		max-width: 640px;
		margin: 0 auto var(--spacing-xl);
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.hero-actions .btn {
		padding: var(--spacing-md) var(--spacing-xl);
		font-size: var(--font-size-base);
	}

	.block {
		padding-bottom: var(--spacing-4xl);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-2xl);
	}

	.process {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--spacing-lg);
	}

	.process-step {
		padding-top: var(--spacing-md);
		border-top: 2px solid var(--color-border);
	}

	.process-num {
		display: block;
		font-weight: 700;
		color: var(--color-brand);
		margin-bottom: var(--spacing-sm);
	}

	.process-step h3 {
		font-size: var(--font-size-base);
		margin-bottom: var(--spacing-xs);
	}

	.process-step p {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.cta-band {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-xl);
		padding: var(--spacing-2xl);
		margin-bottom: var(--spacing-4xl);
		border-radius: var(--radius);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
	}

	.cta-band h2 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--spacing-xs);
	}

	.cta-band p {
		color: var(--color-muted);
	}

	@media (max-width: 960px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.process {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: var(--spacing-3xl);
			padding-bottom: var(--spacing-3xl);
		}

		.hero-title {
			font-size: var(--font-size-2xl);
		}

		.services-grid,
		.projects-grid,
		.process {
			grid-template-columns: 1fr;
		}

		.cta-band {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
