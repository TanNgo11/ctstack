---
import Base from "../../layouts/Base.astro";
import ContactForm from "../../components/ContactForm.astro";
import {
	contactEmail,
	contactPhone,
	langFromParam,
	messengerUrl,
	useTranslations,
	zaloUrl,
} from "../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);
const phoneHref = contactPhone ? `tel:${contactPhone.replace(/\s+/g, "")}` : "";
---

<Base title={t("contact.title")} description={t("contact.intro")}>
	<div class="contact container">
		<header class="contact-header">
			<p class="eyebrow eyebrow-trail">{t("contact.eyebrow")}</p>
			<h1>
				{t("contact.titleA")} <span class="text-accent">{t("contact.titleB")}</span>
			</h1>
			<p class="contact-intro">{t("contact.intro")}</p>
		</header>

		<div class="contact-aside">
			<ul class="trust">
				{t("contact.trust").map((item) => (
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 12 5 5L20 7" />
						</svg>
						{item}
					</li>
				))}
			</ul>
			<div class="channels-block">
				<h2>{t("contact.channelsTitle")}</h2>
				<ul class="channels">
					{zaloUrl && (
						<li>
							<span class="channel-icon channel-letter" aria-hidden="true">
								Z
							</span>
							<span>
								<small>{t("contact.zaloShort")}</small>
								<a href={zaloUrl} target="_blank" rel="noopener">
									Zalo
								</a>
							</span>
						</li>
					)}
					{contactPhone && (
						<li>
							<span class="channel-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
								</svg>
							</span>
							<span>
								<small>{t("contact.phoneShort")}</small>
								<a href={phoneHref}>{contactPhone}</a>
							</span>
						</li>
					)}
					{contactEmail && (
						<li>
							<span class="channel-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="m3 7 9 6 9-6" />
								</svg>
							</span>
							<span>
								<small>{t("contact.emailShort")}</small>
								<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
							</span>
						</li>
					)}
					{messengerUrl && (
						<li>
							<span class="channel-icon channel-letter" aria-hidden="true">
								M
							</span>
							<span>
								<small>{t("contact.messengerShort")}</small>
								<a href={messengerUrl} target="_blank" rel="noopener">
									Messenger
								</a>
							</span>
						</li>
					)}
					<li>
						<span class="channel-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<path d="M12 3v9l6 3" />
								<circle cx="12" cy="12" r="9" />
							</svg>
						</span>
						<span>
							<small>{t("contact.hoursLabel")}</small>
							{t("contact.hours")}
						</span>
					</li>
					<li>
						<span class="channel-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
								<circle cx="12" cy="9.5" r="2.5" />
							</svg>
						</span>
						<span>
							<small>{t("contact.locationLabel")}</small>
							{t("contact.location")}
						</span>
					</li>
				</ul>
			</div>
		</div>

		<div class="contact-form-slot">
			<ContactForm />
		</div>
	</div>

	<section class="contact-steps container" aria-labelledby="contact-steps-title">
		<header class="section-header">
			<div>
				<p class="eyebrow">{t("contact.nextStepsEyebrow")}</p>
				<h2 class="section-title" id="contact-steps-title">
					{t("contact.nextStepsTitle")}
				</h2>
			</div>
		</header>
		<ol class="contact-steps-list">
			{t("contact.nextSteps").map(([title, text], i) => (
				<li>
					<span class="step-num">{String(i + 1).padStart(2, "0")}</span>
					<h3>{title}</h3>
					<p>{text}</p>
				</li>
			))}
		</ol>
	</section>
</Base>

<style>
	.contact {
		display: grid;
		grid-template-areas:
			"intro form"
			"aside form";
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		grid-template-rows: auto 1fr;
		align-items: start;
		column-gap: var(--spacing-3xl);
		padding-block: var(--spacing-2xl) var(--spacing-xl);
	}

	.contact-header {
		grid-area: intro;
		padding-top: var(--spacing-3xl);
	}

	.contact-aside {
		display: flex;
		flex-direction: column;
		grid-area: aside;
		align-self: stretch;
	}

	.eyebrow-trail {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.eyebrow-trail::after {
		content: "";
		width: 28px;
		height: 1px;
		background: currentColor;
	}

	.contact-header h1 {
		margin-bottom: var(--spacing-lg);
		font-size: clamp(2.5rem, 4.4vw, 4rem);
		font-weight: var(--font-weight-display);
		line-height: 1.12;
		letter-spacing: var(--tracking-tight);
	}

	.contact-header h1 span {
		display: block;
	}

	.contact-intro {
		max-width: 34em;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.6;
	}

	.trust {
		display: grid;
		gap: 10px;
		margin-top: var(--spacing-xl);
		list-style: none;
	}

	.trust li {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.trust svg {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		fill: none;
		stroke: var(--color-brand);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.channels-block {
		margin-top: var(--spacing-2xl);
	}

	.channels-block h2 {
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.channels {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-sm);
		list-style: none;
	}

	.channels li {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		min-width: 0;
		padding: var(--spacing-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.channels small {
		display: block;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}

	.channels a {
		display: block;
		overflow: hidden;
		color: var(--color-text);
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.channel-icon {
		display: grid;
		flex-shrink: 0;
		width: 30px;
		height: 30px;
		place-items: center;
		border-radius: 50%;
		color: var(--color-brand);
		background: color-mix(in srgb, var(--color-brand) 10%, transparent);
	}

	.channel-icon svg {
		width: 17px;
		height: 17px;
	}

	.channel-letter {
		font-size: var(--font-size-sm);
		font-weight: 700;
	}

	.contact-form-slot {
		grid-area: form;
	}

	.contact-steps {
		padding-block: var(--spacing-xl) var(--spacing-3xl);
	}

	.contact-steps-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--color-border);
		list-style: none;
	}

	.contact-steps-list li {
		padding: var(--spacing-lg) var(--spacing-lg) 0 0;
	}

	.contact-steps-list li + li {
		padding-inline-start: var(--spacing-lg);
		border-inline-start: 1px solid var(--color-border);
	}

	.step-num {
		display: block;
		margin-bottom: var(--spacing-md);
		color: var(--color-brand);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.contact-steps-list h3 {
		margin-bottom: var(--spacing-xs);
		font-size: var(--font-size-lg);
		font-weight: 600;
	}

	.contact-steps-list p {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	@media (max-width: 900px) {
		.contact {
			grid-template-areas:
				"intro"
				"form"
				"aside";
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			row-gap: var(--spacing-lg);
		}

		.contact-header {
			padding-top: 0;
		}
	}

	@media (max-width: 640px) {
		.contact-header h1 {
			font-size: 2.25rem;
		}

		.contact-header h1 span {
			display: inline;
			background: none;
			color: inherit;
		}

		.contact-intro {
			font-size: var(--font-size-base);
		}

		.channels-block {
			margin-top: var(--spacing-xl);
		}

		.channels {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.contact-steps-list {
			grid-template-columns: 1fr;
		}

		.contact-steps-list li,
		.contact-steps-list li + li {
			padding: var(--spacing-md) 0;
			border-inline-start: 0;
			border-bottom: 1px solid var(--color-border);
		}
	}
</style>
