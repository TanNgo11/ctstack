---
import Base from "../../layouts/Base.astro";
import ContactForm from "../../components/ContactForm.astro";
import { contactEmail, useTranslations, langFromParam } from "../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);
---

<Base title={t("contact.title")} description={t("contact.intro")}>
	<div class="contact container">
		<header class="contact-header">
			<p class="eyebrow eyebrow-trail">{t("contact.eyebrow")}</p>
			<h1>
				{t("contact.titleA")} <span class="text-accent">{t("contact.titleB")}</span>
			</h1>
			<p class="contact-intro">{t("contact.intro")}</p>
		</header>

		<div class="contact-aside">
			<ul class="trust">
				{t("contact.trust").map((item) => (
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 12 5 5L20 7" />
						</svg>
						{item}
					</li>
				))}
			</ul>
			<ul class="channels">
				{contactEmail && (
					<li>
						<span class="channel-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<rect x="3" y="5" width="18" height="14" rx="2" />
								<path d="m3 7 9 6 9-6" />
							</svg>
						</span>
						<span>
							<small>{t("contact.emailShort")}</small>
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
						</span>
					</li>
				)}
				<li>
					<span class="channel-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
							<circle cx="12" cy="9.5" r="2.5" />
						</svg>
					</span>
					<span>
						<small>{t("contact.locationLabel")}</small>
						{t("contact.location")}
					</span>
				</li>
			</ul>
		</div>

		<div class="contact-form-slot">
			<ContactForm />
		</div>
	</div>
</Base>

<style>
	.contact {
		display: grid;
		grid-template-areas:
			"intro form"
			"aside form";
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		grid-template-rows: auto 1fr;
		align-items: start;
		column-gap: var(--spacing-3xl);
		padding-block: var(--spacing-2xl) var(--spacing-xl);
	}

	.contact-header {
		grid-area: intro;
		padding-top: var(--spacing-3xl);
	}

	.contact-aside {
		display: flex;
		flex-direction: column;
		grid-area: aside;
		align-self: stretch;
	}

	.eyebrow-trail {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.eyebrow-trail::after {
		content: "";
		width: 28px;
		height: 1px;
		background: currentColor;
	}

	.contact-header h1 {
		margin-bottom: var(--spacing-lg);
		font-size: clamp(2.5rem, 4.4vw, 4rem);
		font-weight: var(--font-weight-display);
		line-height: 1.12;
		letter-spacing: var(--tracking-tight);
	}

	.contact-header h1 span {
		display: block;
	}

	.contact-intro {
		max-width: 34em;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.6;
	}

	.trust {
		display: grid;
		gap: 10px;
		margin-top: var(--spacing-xl);
		list-style: none;
	}

	.trust li {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.trust svg {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		fill: none;
		stroke: var(--color-brand);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.channels {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-xl);
		list-style: none;
	}

	.channels li {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.channels li + li {
		padding-inline-start: var(--spacing-xl);
		border-inline-start: 1px solid var(--color-border);
	}

	.channels small {
		display: block;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}

	.channels a {
		color: var(--color-text);
		text-decoration: none;
	}

	.channel-icon {
		color: var(--color-brand);
	}

	.channel-icon svg {
		width: 26px;
		height: 26px;
	}

	.contact-form-slot {
		grid-area: form;
	}

	@media (max-width: 900px) {
		.contact {
			grid-template-areas:
				"intro"
				"form"
				"aside";
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			row-gap: var(--spacing-lg);
		}

		.contact-header {
			padding-top: 0;
		}
	}

	@media (max-width: 640px) {
		.contact-header h1 {
			font-size: 2.25rem;
		}

		.contact-header h1 span {
			display: inline;
			background: none;
			color: inherit;
		}

		.contact-intro {
			font-size: var(--font-size-base);
		}

		.channels {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--spacing-sm);
			margin-top: 0;
		}

		.channels li {
			padding: var(--spacing-md);
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			background: var(--color-surface);
		}

		.channels li + li {
			padding-inline-start: var(--spacing-md);
			border-inline-start: 1px solid var(--color-border);
		}
	}
</style>
