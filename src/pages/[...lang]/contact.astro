---
import { Form } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";
import Base from "../../layouts/Base.astro";
import { contactEmail, contactFormId, useTranslations, langFromParam } from "../../i18n/ui";

const lang = langFromParam(Astro.params.lang);
if (!lang) return Astro.rewrite("/404");
const t = useTranslations(lang);
---

<Base title={t("contact.title")} description={t("contact.intro")}>
	<div class="contact container">
		<header class="contact-header">
			<p class="eyebrow eyebrow-trail">{t("contact.eyebrow")}</p>
			<h1>
				{t("contact.titleA")} <span class="text-gradient">{t("contact.titleB")}</span>
			</h1>
			<p class="contact-intro">{t("contact.intro")}</p>
		</header>

		<div class="contact-aside">
			<ul class="channels">
				{contactEmail && (
					<li>
						<span class="channel-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<rect x="3" y="5" width="18" height="14" rx="2" />
								<path d="m3 7 9 6 9-6" />
							</svg>
						</span>
						<span>
							<small>{t("contact.emailShort")}</small>
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
						</span>
					</li>
				)}
				<li>
					<span class="channel-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
							<circle cx="12" cy="9.5" r="2.5" />
						</svg>
					</span>
					<span>
						<small>{t("contact.locationLabel")}</small>
						{t("contact.location")}
					</span>
				</li>
			</ul>

			<p class="contact-tagline" aria-hidden="true">
				<span>{t("contact.taglineA")}</span>
				<span>{t("contact.taglineB")}</span>
			</p>
		</div>

		<section
			class="contact-form"
			aria-labelledby="form-title"
			data-select-placeholders={JSON.stringify({
				service: t("contact.selectService"),
				budget: t("contact.selectBudget"),
				"*": t("contact.selectDefault"),
			})}
		>
			<h2 id="form-title">{t("contact.formTitle")}</h2>
			<p class="form-subtitle">{t("contact.formSubtitle")}</p>
			<Form id={contactFormId[lang]} />
			<p class="privacy">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M7 10V7a5 5 0 0 1 10 0v3h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"></path>
				</svg>
				{t("contact.privacy")}
			</p>
		</section>
	</div>
</Base>

<script>
	// The forms plugin renders textareas with whitespace inside (hiding the
	// placeholder and letting `required` pass on blanks) and selects with no
	// empty choice (silently submitting the first option). Fix both here.
	const box = document.querySelector<HTMLElement>(".contact-form");
	const labels = JSON.parse(box?.dataset.selectPlaceholders ?? "{}") as Record<string, string>;
	(Array.from(box?.querySelectorAll("textarea") ?? []) as unknown as HTMLTextAreaElement[]).forEach(
		(el) => {
			if (!el.value.trim()) el.value = "";
		},
	);
	(Array.from(box?.querySelectorAll("select") ?? []) as unknown as HTMLSelectElement[]).forEach(
		(el) => {
			if (el.querySelector('option[value=""]')) return;
			const option = new Option(labels[el.name] ?? labels["*"] ?? "", "", true, true);
			option.disabled = !!el.required;
			el.insertBefore(option, el.firstChild);
			el.value = "";
			el.classList.add("is-empty");
			el.addEventListener("change", () => el.classList.toggle("is-empty", !el.value));
		},
	);
</script>

<style>
	.contact {
		display: grid;
		grid-template-areas:
			"intro form"
			"aside form";
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		grid-template-rows: auto 1fr;
		align-items: start;
		column-gap: var(--spacing-3xl);
		padding-block: var(--spacing-2xl) var(--spacing-xl);
	}

	.contact-header {
		grid-area: intro;
		padding-top: var(--spacing-3xl);
	}

	.contact-aside {
		display: flex;
		flex-direction: column;
		grid-area: aside;
		align-self: stretch;
	}

	.eyebrow-trail {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.eyebrow-trail::after {
		content: "";
		width: 28px;
		height: 1px;
		background: currentColor;
	}

	.contact-header h1 {
		margin-bottom: var(--spacing-lg);
		font-size: clamp(2.5rem, 4.4vw, 4rem);
		font-weight: var(--font-weight-display);
		line-height: 1.12;
		letter-spacing: var(--tracking-tight);
	}

	.contact-header h1 span {
		display: block;
	}

	.contact-intro {
		max-width: 34em;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.6;
	}

	.channels {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-xl);
		list-style: none;
	}

	.channels li {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.channels li + li {
		padding-inline-start: var(--spacing-xl);
		border-inline-start: 1px solid var(--color-border);
	}

	.channels small {
		display: block;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}

	.channels a {
		color: var(--color-text);
		text-decoration: none;
	}

	.channel-icon {
		color: var(--color-brand);
	}

	.channel-icon svg {
		width: 26px;
		height: 26px;
	}

	.contact-tagline {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: auto;
		padding-top: var(--spacing-3xl);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.contact-tagline::after {
		content: "";
		width: 28px;
		height: 2px;
		margin-top: var(--spacing-md);
		background: var(--color-brand);
	}

	.contact-form {
		grid-area: form;
		padding: var(--spacing-xl);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}

	.contact-form h2 {
		font-size: var(--font-size-xl);
		font-weight: 600;
	}

	.form-subtitle {
		margin: 4px 0 var(--spacing-lg);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.privacy {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
	}

	.privacy svg {
		width: 14px;
		height: 14px;
	}

	/* Forms plugin theme (see @emdash-cms/plugin-forms/styles) */
	.contact-form :global(.ec-form) {
		--ec-form-gap: var(--spacing-md);
		--ec-form-field-border: 1px solid var(--color-border);
		--ec-form-field-radius: var(--radius);
		--ec-form-field-bg: var(--color-bg);
		--ec-form-help-color: var(--color-muted);
		--ec-form-error-color: var(--color-danger);
		--ec-form-required-color: var(--color-danger);
		--ec-form-submit-bg: var(--accent-gradient);
		--ec-form-submit-color: var(--color-on-brand);
		--ec-form-submit-radius: var(--radius);
		--ec-form-submit-padding: 14px var(--spacing-xl);
	}

	.contact-form :global(.ec-form-label) {
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.contact-form :global(:is(input, textarea, select)) {
		color: var(--color-text);
		font: inherit;
	}

	.contact-form :global(textarea) {
		min-height: 96px;
	}

	.contact-form :global(select.is-empty) {
		color: var(--color-muted);
	}

	.contact-form :global(::placeholder) {
		color: var(--color-muted);
		opacity: 0.8;
	}

	.contact-form :global(.ec-form-nav) {
		margin-top: var(--spacing-sm);
	}

	.contact-form :global(.ec-form-submit) {
		width: 100%;
		min-height: 48px;
		border: 0;
		background: var(--accent-gradient);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 8px 24px color-mix(in srgb, #3b82f6 22%, transparent);
	}

	.contact-form :global(.ec-form-submit)::after {
		content: " →";
	}

	@media (max-width: 900px) {
		.contact {
			grid-template-areas:
				"intro"
				"form"
				"aside";
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			row-gap: var(--spacing-lg);
		}

		.contact-header {
			padding-top: 0;
		}

		.contact-tagline {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.contact-header h1 {
			font-size: 2.25rem;
		}

		.contact-header h1 span {
			display: inline;
			background: none;
			color: inherit;
		}

		.contact-intro {
			font-size: var(--font-size-base);
		}

		.contact-form {
			padding: var(--spacing-lg) var(--spacing-md);
		}

		/* Field icons (mobile mockup) */
		.contact-form :global(.ec-form-input) {
			padding-inline-start: 44px;
			background-position: 14px 14px;
			background-repeat: no-repeat;
			background-size: 18px;
		}

		.contact-form :global([name="name"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%228%22%20r%3D%224%22/%3E%3Cpath%20d%3D%22M4%2021a8%208%200%200%201%2016%200%22/%3E%3C/svg%3E");
		}

		.contact-form :global([name="phone"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M22%2016.9v3a2%202%200%200%201-2.2%202%2019.8%2019.8%200%200%201-8.6-3.1%2019.5%2019.5%200%200%201-6-6A19.8%2019.8%200%200%201%202.1%204.2%202%202%200%200%201%204.1%202h3a2%202%200%200%201%202%201.7c.1%201%20.4%201.9.7%202.8a2%202%200%200%201-.5%202.1L8.1%209.9a16%2016%200%200%200%206%206l1.3-1.3a2%202%200%200%201%202.1-.4c.9.3%201.8.6%202.8.7a2%202%200%200%201%201.7%202z%22/%3E%3C/svg%3E");
		}

		.contact-form :global([name="email"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%222%22%20y%3D%224%22%20width%3D%2220%22%20height%3D%2216%22%20rx%3D%222%22/%3E%3Cpath%20d%3D%22m22%207-10%206L2%207%22/%3E%3C/svg%3E");
		}

		.contact-form :global([name="service"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M8%206h13M8%2012h13M8%2018h13M3%206h.01M3%2012h.01M3%2018h.01%22/%3E%3C/svg%3E");
		}

		.contact-form :global([name="budget"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%2210%22/%3E%3Cpath%20d%3D%22M16%208h-6a2%202%200%201%200%200%204h4a2%202%200%201%201%200%204H8M12%2018V6%22/%3E%3C/svg%3E");
		}

		.contact-form :global([name="message"]) {
			background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%239aa3b2%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M14%202H6a2%202%200%200%200-2%202v16a2%202%200%200%200%202%202h12a2%202%200%200%200%202-2V8z%22/%3E%3Cpath%20d%3D%22M14%202v6h6M16%2013H8M16%2017H8%22/%3E%3C/svg%3E");
		}

		.channels {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--spacing-sm);
			margin-top: 0;
		}

		.channels li {
			padding: var(--spacing-md);
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			background: var(--color-surface);
		}

		.channels li + li {
			padding-inline-start: var(--spacing-md);
			border-inline-start: 1px solid var(--color-border);
		}
	}
</style>
