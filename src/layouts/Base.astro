---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import {
	langFromPath,
	contactEmail,
	contactPhone,
	langNames,
	localizePath,
	messengerUrl,
	zaloUrl,
	locales,
	unlocalizePath,
	useTranslations,
	type Lang,
} from "../i18n/ui";
import Logo from "../components/Logo.astro";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	content?: { collection: string; id: string; slug?: string | null };
	/**
	 * Paths of this page in each language. Defaults to the same path with a
	 * swapped locale prefix; content pages pass their translations' URLs, or
	 * null for a language with no translation.
	 */
	alternates?: Partial<Record<Lang, string | null>>;
	/** Optional breadcrumb trail for structured data. */
	breadcrumbs?: Array<{ name: string; url: string }>;
	/** Hide the CTA band above the footer (pages that end with their own form). */
	hideCta?: boolean;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	content,
	alternates,
	breadcrumbs,
	hideCta = false,
} = Astro.props;
const lang = langFromPath(Astro.originPathname ?? Astro.url.pathname);
const t = useTranslations(lang);

const settingsResult = await getSiteSettingsWithCacheHint();
const settings = settingsResult.data;
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const siteTitle = settings?.title || "CTStack";
const separator = settings?.seo?.titleSeparator || " — ";
const fullTitle = !title
	? `${siteTitle}${separator}${t("site.tagline")}`
	: title === siteTitle || title.endsWith(`${separator}${siteTitle}`)
		? title
		: `${title}${separator}${siteTitle}`;
const configuredSiteUrl = typeof settings?.url === "string" ? settings.url : null;
const siteOrigin = (() => {
	try {
		return new URL(configuredSiteUrl || Astro.url.origin).origin;
	} catch {
		return Astro.url.origin;
	}
})();
const siteDescription = t("site.description");
const routePath = unlocalizePath(Astro.url.pathname).replace(/\/$/, "") || "/";
const descriptionFallbacks: Record<string, string> = {
	"/": t("seo.homeDescription"),
	"/projects": t("seo.projectsDescription"),
	"/services": t("seo.servicesDescription"),
	"/about": t("seo.aboutDescription"),
	"/contact": t("seo.contactDescription"),
	"/404": t("seo.notFoundDescription"),
};
const resolvedDescription = description || descriptionFallbacks[routePath] || siteDescription;
const siteLogo = settings?.logo?.url ? settings.logo : null;
const canonicalUrl = (() => {
	try {
		const parsed = canonical ? new URL(canonical, Astro.url.origin) : Astro.url;
		return new URL(`${parsed.pathname}${parsed.search}`, `${siteOrigin}/`).href;
	} catch {
		return new URL(Astro.url.pathname, `${siteOrigin}/`).href;
	}
})();
const defaultOgImage = new URL("/og-default.png", `${siteOrigin}/`).href;
const absoluteUrl = (value: string): string => {
	try {
		return new URL(value, `${siteOrigin}/`).href;
	} catch {
		return value;
	}
};
const pageImage = image ? absoluteUrl(image) : defaultOgImage;

// Language alternates: same page, other locale.
const basePath = unlocalizePath(Astro.url.pathname);
const altPaths = Object.fromEntries(
	locales.map((l) => [
		l,
		alternates && l in alternates ? alternates[l] : localizePath(basePath, l),
	]),
) as Record<Lang, string | null | undefined>;
const otherLang: Lang = lang === "vi" ? "en" : "vi";
const switchHref = altPaths[otherLang] ?? localizePath("/", otherLang);
const breadcrumbItems =
	breadcrumbs ??
	(content?.collection === "projects"
		? [
				{ name: t("nav.home"), url: localizePath("/", lang) },
				{ name: t("projects.title"), url: localizePath("/projects", lang) },
				{
					name: pageTitle ?? title ?? t("projects.title"),
					url: Astro.url.pathname,
				},
			]
		: undefined);
const jsonLd = (value: unknown): string =>
	JSON.stringify(value)
		.replace(/</g, "\\u003c")
		.replace(/>/g, "\\u003e")
		.replace(/\u2028/g, "\\u2028")
		.replace(/\u2029/g, "\\u2029");
const organizationJsonLd = jsonLd({
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteOrigin}/#organization`,
	name: siteTitle,
	url: siteOrigin,
	logo: absoluteUrl(siteLogo?.url || defaultOgImage),
});
const breadcrumbJsonLd = breadcrumbItems?.length
	? jsonLd({
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: breadcrumbItems.map((item, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: item.name,
				item: absoluteUrl(item.url),
			})),
		})
	: null;

const nav = [
	{ href: localizePath("/projects", lang), label: t("nav.projects") },
	{ href: localizePath("/services", lang), label: t("nav.services") },
	{ href: localizePath("/about", lang), label: t("nav.about") },
];
const contactHref = localizePath("/contact", lang);
const phoneHref = contactPhone ? `tel:${contactPhone.replace(/\s+/g, "")}` : "";
const quickContacts = [
	{ href: zaloUrl, label: t("floating.zalo"), icon: "Z" },
	{ href: phoneHref, label: t("floating.call"), icon: "☎" },
	{ href: messengerUrl, label: t("floating.messenger"), icon: "M" },
].filter((c) => c.href);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: resolvedDescription,
	canonical: canonicalUrl,
	image: pageImage,
	content,
	locale: lang,
	seo: { ogImage: pageImage, robots },
	siteName: siteTitle,
	siteUrl: siteOrigin,
	breadcrumbs: breadcrumbItems,
});

const isLoggedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script type="application/ld+json" set:html={organizationJsonLd} />
		{breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-heading" preload />
		{!content &&
			!robots?.toLowerCase().includes("noindex") &&
			locales.map(
				(l) =>
					altPaths[l] && (
						<link
							rel="alternate"
							hreflang={l}
							href={new URL(altPaths[l]!, `${siteOrigin}/`).href}
						/>
					),
			)}
		{!content && !robots?.toLowerCase().includes("noindex") && altPaths.vi && (
			<link
				rel="alternate"
				hreflang="x-default"
				href={new URL(altPaths.vi, `${siteOrigin}/`).href}
			/>
		)}
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label="Main">
				<a href={localizePath("/", lang)} class="site-title">
					<Logo title={siteTitle} image={siteLogo} />
				</a>
				<div class="nav-links">
					{nav.map((item) => (
						<a
							href={item.href}
							aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
						>
							{item.label}
						</a>
					))}
					{isLoggedIn && (
						<a href="/_emdash/admin" class="nav-admin">
							Admin
						</a>
					)}
					<a
						href={switchHref}
						class="nav-lang"
						hreflang={otherLang}
						lang={otherLang}
						title={langNames[otherLang]}
					>
						{otherLang.toUpperCase()}
					</a>
				</div>
				<a href={contactHref} class="btn btn-primary btn-sm nav-cta">
					{t("nav.cta")}
				</a>
				<button
					class="menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="mobile-menu"
					aria-label={t("nav.menu")}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
				</button>
			</nav>
		</header>

		<div class="mobile-menu" id="mobile-menu" hidden>
			<div class="mobile-menu-top">
				<Logo title={siteTitle} image={siteLogo} size="sm" />
				<button class="menu-close" type="button" aria-label={t("nav.close")}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M6 6l12 12M18 6 6 18" />
					</svg>
				</button>
			</div>
			<nav class="mobile-menu-links" aria-label="Mobile">
				<a href={localizePath("/", lang)}>{t("nav.home")}</a>
				{nav.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
				<a href={contactHref}>{t("nav.contact")}</a>
			</nav>
			<div class="mobile-menu-bottom">
				<a href={contactHref} class="btn btn-primary">
					{t("nav.cta")} <span aria-hidden="true">→</span>
				</a>
				{quickContacts.map((c) => (
					<a
						href={c.href}
						class="btn btn-ghost"
						rel="noopener"
						target={c.href.startsWith("http") ? "_blank" : undefined}
					>
						{c.label}
					</a>
				))}
				<a href={switchHref} hreflang={otherLang} lang={otherLang} class="mobile-menu-lang">
					{langNames[otherLang]}
				</a>
			</div>
		</div>

		<main>
			<slot />
		</main>

		{!hideCta && (
			<section class="global-cta container" aria-labelledby="global-cta-title">
				<div class="global-cta-inner">
					<div>
						<h2 id="global-cta-title">{t("global.ctaTitle")}</h2>
						<p>{t("global.ctaText")}</p>
					</div>
					<a class="btn btn-primary" href={contactHref}>
						{t("global.ctaAction")} <span aria-hidden="true">→</span>
					</a>
				</div>
			</section>
		)}

		<footer class="site-footer container">
			<div class="footer-grid">
				<div class="footer-brand">
					<span class="footer-logo">
						<Logo title={siteTitle} image={siteLogo} size="sm" />
					</span>
					<p class="footer-tagline">{t("site.tagline")}</p>
					<p class="footer-tagline">{t("footer.location")}</p>
					{contactPhone && <a href={phoneHref}>{contactPhone}</a>}
					{contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
				</div>
				<div class="footer-column">
					<h2>{t("footer.services")}</h2>
					<a href={localizePath("/services", lang)}>{t("nav.services")}</a>
					<a href={localizePath("/projects", lang)}>{t("nav.projects")}</a>
				</div>
				<div class="footer-column">
					<h2>{t("footer.company")}</h2>
					<a href={localizePath("/about", lang)}>{t("nav.about")}</a>
					<a href={contactHref}>{t("nav.contact")}</a>
				</div>
				<div class="footer-column">
					<h2>{t("footer.support")}</h2>
					<a href={localizePath("/faq", lang)}>{t("footer.faq")}</a>
					<a href={localizePath("/bao-hanh", lang)}>{t("footer.warranty")}</a>
					<a href={localizePath("/chinh-sach-bao-mat", lang)}>{t("footer.privacy")}</a>
					<a href={localizePath("/dieu-khoan", lang)}>{t("footer.terms")}</a>
				</div>
				<div class="footer-column">
					<h2>{t("footer.connect")}</h2>
					<a href={contactHref}>{t("footer.contact")}</a>
					{quickContacts.map((c) => (
						<a
							href={c.href}
							rel="noopener"
							target={c.href.startsWith("http") ? "_blank" : undefined}
						>
							{c.label}
						</a>
					))}
				</div>
			</div>
			<div class="footer-bottom">
				<p class="footer-powered">
					© {new Date().getFullYear()} {siteTitle}. {t("footer.rights")}
				</p>
				<div class="footer-bottom-right">
					<div class="theme-switcher">
						<button type="button" class="theme-btn" data-theme="light" aria-pressed="false">
							{t("theme.light")}
						</button>
						<button type="button" class="theme-btn" data-theme="dark" aria-pressed="false">
							{t("theme.dark")}
						</button>
						<button type="button" class="theme-btn" data-theme="system" aria-pressed="false">
							{t("theme.system")}
						</button>
					</div>
					<a href={switchHref} hreflang={otherLang} lang={otherLang} class="footer-lang">
						{langNames[otherLang]}
					</a>
				</div>
			</div>
		</footer>
		{quickContacts.length > 0 && (
			<nav class="floating-contact" aria-label={t("floating.contact")}>
				{quickContacts.map((c) => (
					<a
						href={c.href}
						title={c.label}
						aria-label={c.label}
						rel="noopener"
						target={c.href.startsWith("http") ? "_blank" : undefined}
					>
						<span aria-hidden="true">{c.icon}</span>
					</a>
				))}
			</nav>
		)}
		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Theme switcher
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setTheme(theme: string) {
				if (theme !== "light" && theme !== "dark" && theme !== "system") {
					theme = "system";
				}
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const match = document.cookie.match(THEME_REGEX);
				return match ? match[1] : "system";
			}

			// Initialize - apply stored theme on load
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			// Mobile full-screen menu
			const menu = document.getElementById("mobile-menu");
			const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
			function setMenu(open: boolean) {
				if (!menu || !menuToggle) return;
				menu.hidden = !open;
				menuToggle.setAttribute("aria-expanded", String(open));
				document.documentElement.style.overflow = open ? "hidden" : "";
				if (!open) menuToggle.focus();
			}
			menuToggle?.addEventListener("click", () => setMenu(true));
			menu?.querySelector(".menu-close")?.addEventListener("click", () => setMenu(false));
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && menu && !menu.hidden) setMenu(false);
			});

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>
		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a {
					color: currentColor;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
				}

				h1 {
					font-size: var(--font-size-4xl);
				}

				h2 {
					font-size: var(--font-size-2xl);
				}

				h3 {
					font-size: var(--font-size-xl);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 20;
				border-bottom: 1px solid transparent;
				background: color-mix(in srgb, var(--color-bg) 72%, transparent);
				backdrop-filter: blur(14px);
				-webkit-backdrop-filter: blur(14px);
			}

			.nav {
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-items: center;
				gap: var(--spacing-lg);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-md) 48px;
				box-sizing: content-box;
			}

			.site-title {
				color: var(--color-text);
				text-decoration: none;
			}

			.menu-toggle,
			.menu-close {
				display: none;
				width: 40px;
				height: 40px;
				place-items: center;
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				color: var(--color-text);
				background: transparent;
				cursor: pointer;
			}

			.menu-toggle svg,
			.menu-close svg {
				width: 20px;
				height: 20px;
				fill: none;
				stroke: currentColor;
				stroke-width: 1.8;
				stroke-linecap: round;
			}

			.mobile-menu {
				position: fixed;
				inset: 0;
				z-index: 50;
				display: flex;
				flex-direction: column;
				padding: var(--spacing-md) 20px var(--spacing-xl);
				background: var(--color-bg);
			}

			.mobile-menu[hidden] {
				display: none;
			}

			.mobile-menu-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.mobile-menu .menu-close {
				display: grid;
			}

			.mobile-menu-links {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-xs);
				margin-top: var(--spacing-2xl);
			}

			.mobile-menu-links a {
				padding: 12px 0;
				border-bottom: 1px solid var(--color-border);
				color: var(--color-text);
				font-size: 1.5rem;
				font-weight: 600;
				text-decoration: none;
			}

			.mobile-menu-bottom {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-sm);
				margin-top: auto;
			}

			.mobile-menu-lang {
				padding: var(--spacing-sm);
				color: var(--color-muted);
				text-align: center;
				text-decoration: none;
			}

			.nav-links {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-xl);
				font-size: var(--font-size-sm);
			}

			.nav-links a {
				position: relative;
				color: var(--color-muted);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.nav-links a:hover,
			.nav-links a[aria-current="page"] {
				color: var(--color-text);
			}

			.nav-links a[aria-current="page"]::after {
				content: "";
				position: absolute;
				left: 50%;
				bottom: -10px;
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--color-brand);
				transform: translateX(-50%);
			}

			.nav-admin {
				opacity: 0.5;
			}

			.nav-links .nav-lang {
				font-weight: 600;
				letter-spacing: var(--tracking-wide);
			}

			.global-cta {
				margin-top: var(--spacing-2xl);
				margin-bottom: var(--spacing-3xl);
			}

			.global-cta-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-xl);
				padding: var(--spacing-2xl) 56px;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-card);
				background: var(--color-surface);
			}

			.global-cta h2 {
				font-size: clamp(1.75rem, 2.6vw, 2.5rem);
				font-weight: var(--font-weight-display);
				letter-spacing: -0.02em;
			}

			.global-cta p {
				margin-top: var(--spacing-xs);
				color: var(--color-muted);
				font-size: var(--font-size-lg);
			}

			.global-cta .btn {
				flex-shrink: 0;
				min-width: 180px;
			}

			.site-footer {
				padding-block: var(--spacing-2xl) var(--spacing-xl);
				border-top: 1px solid var(--color-border);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr repeat(4, 1fr);
				gap: var(--spacing-xl);
			}

			.footer-tagline {
				margin-top: var(--spacing-xs);
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			.footer-brand a,
			.footer-column a {
				display: block;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
				text-decoration: none;
			}

			.footer-brand a {
				margin-top: var(--spacing-xs);
			}

			.footer-brand a:hover,
			.footer-column a:hover {
				color: var(--color-text);
			}

			.footer-column {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-sm);
			}

			.footer-column h2 {
				margin-bottom: var(--spacing-xs);
				color: var(--color-text);
				font-size: var(--font-size-sm);
				font-weight: 600;
			}

			.footer-bottom {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-md);
				flex-wrap: wrap;
				margin-top: var(--spacing-2xl);
				padding-top: var(--spacing-lg);
				border-top: 1px solid var(--color-border);
			}

			.footer-bottom-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-md);
			}

			.footer-lang {
				color: var(--color-muted);
				font-size: var(--font-size-sm);
				text-decoration: none;
			}

			.footer-lang:hover {
				color: var(--color-text);
			}

			.theme-switcher {
				display: flex;
				gap: var(--spacing-xs);
			}

			.theme-btn {
				padding: var(--spacing-xs) var(--spacing-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-pill);
				color: var(--color-muted);
				background: transparent;
				font-family: var(--font-body);
				font-size: var(--font-size-xs);
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
			}

			.theme-btn.active {
				border-color: var(--color-brand);
				color: var(--color-text);
				background: var(--color-surface);
			}

			.footer-powered {
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			.floating-contact {
				position: fixed;
				right: 24px;
				bottom: 24px;
				z-index: 10;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.floating-contact a {
				display: grid;
				width: 48px;
				height: 48px;
				place-items: center;
				border-radius: 50%;
				color: var(--color-on-brand);
				background: var(--color-brand);
				box-shadow: 0 4px 12px #0003;
				text-decoration: none;
			}

			@media (max-width: 768px) {
				.nav {
					grid-template-columns: 1fr auto;
					row-gap: var(--spacing-sm);
					padding: var(--spacing-sm) 20px;
				}

				.nav {
					grid-template-columns: 1fr auto auto;
					column-gap: var(--spacing-sm);
				}

				.menu-toggle {
					display: grid;
				}

				.nav-links {
					grid-column: 1 / -1;
					grid-row: 2;
					justify-content: flex-start;
					gap: var(--spacing-lg);
					overflow-x: auto;
					padding-bottom: var(--spacing-xs);
				}

				.nav-links a[aria-current="page"]::after {
					bottom: -4px;
				}

				.global-cta-inner {
					flex-direction: column;
					align-items: flex-start;
					padding: var(--spacing-lg);
				}

				.global-cta p {
					font-size: var(--font-size-sm);
				}

				.footer-grid {
					grid-template-columns: repeat(2, 1fr);
				}

				.footer-brand {
					grid-column: 1 / -1;
				}

				.floating-contact {
					right: 16px;
					bottom: 16px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
			}
		</style>
	</body>
</html>
